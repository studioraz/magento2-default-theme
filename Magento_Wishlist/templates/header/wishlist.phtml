declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Hyva\Theme\ViewModel\Customer;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */
/** @var Customer $customer */

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);
$customer = $viewModels->require(Customer::class);

$isLoggedIn = $customer->customerLoggedIn();
$wishlistUrl = $block->getUrl('wishlist');
$loginUrl = $block->getUrl('customer/account/login');
?>

<a
    href="<?= $escaper->escapeUrl($isLoggedIn ? $wishlistUrl : $loginUrl) ?>"
    @click="handleWishlistClick($event)"
    class="relative inline-flex btn bg-transparent border-transparent p-1 top-0.25"
    x-data="initWishlistHeader(<?= $isLoggedIn ? 'true' : 'false' ?>)"
    @private-content-loaded.window="receiveWishlistData"
    aria-label="<?= $escaper->escapeHtmlAttr(__('My Wish List')); ?>"
    :aria-label="linkAriaLabel"
>
    <?= $lucideIcons->heartHtml('', 26, 26, ["aria-hidden" => "true"]) ?>
    <template x-if="itemCount">
        <span
            x-text="itemCount"
            class="absolute -top-1.5 -right-1.5 px-2 py-1 rounded-full bg-primary text-on-primary text-xs
                font-semibold leading-none text-center uppercase tabular-nums"
            aria-hidden="true"
        ></span>
    </template>
</a>

<script>
    function initWishlistHeader(isLoggedIn) {
        return {
            isLoggedIn: isLoggedIn,
            wishlistProducts: null,
            itemCount: 0,
            linkAriaLabel() {
                const countLabel = this.itemCount > 1
                    ? hyva.str('<?= $escaper->escapeJs(__('%1 Items')) ?>', this.itemCount)
                    : hyva.str('<?= $escaper->escapeJs(__('%1 Item')) ?>', this.itemCount);
                return `<?= $escaper->escapeJs(__('Wishlist Products')) ?> (${countLabel})`;
            },
            receiveWishlistData() {
                const data = this.$event.detail.data;
                this.itemCount = data.wishlist ? parseInt(data.wishlist.counter) : 0;
            },
            handleWishlistClick(event) {
                if (this.isLoggedIn) {
                    return;
                }

                let isOtpModuleActive = false;
                try {
                    isOtpModuleActive = typeof initAuthentication === 'function' &&
                        initAuthentication.toString().includes('isOpenOtpOn');
                } catch (e) {}

                if (isOtpModuleActive) {
                    event.preventDefault();
                    window.dispatchEvent(new CustomEvent('toggle-authentication'));
                }
            }
        }
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initWishlistHeader', initWishlistHeader);
    }, { once: true })
</script>
<?php $hyvaCsp->registerInlineScript() ?>
