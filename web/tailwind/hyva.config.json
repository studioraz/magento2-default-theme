{
  "tailwind": {
    "exclude": [
      "generated/hyva-source.css"
    ],
    "include": [
      {
        "comment": "Example of how to include parent themes or modules. Use the 'src' key, instead of 'example_src' to use this",
        "example_src": "vendor/hyva-themes/magento2-default-theme"
      }
    ]
  },
  "tokens": {
    "values": {
      "color": {
        "primary": {
          "lighter": "oklch(46% 0.2 265)",
          "DEFAULT": "var(--color-blue-600)",
          "darker": "var(--color-brand-primary-darker)"
        },
        "secondary": {
          "lighter": "var(--color-brand-secondary-lighter)",
          "DEFAULT": "var(--color-brand-secondary)",
          "darker": "var(--color-brand-secondary-darker)"
        },
        "on": {
          "primary": "var(--color-brand-primary-text)"
        },
        "brand": {
          "primary": {
            "DEFAULT": "var(--color-primary)",
            "lighter": "var(--color-blue-500)",
            "darker": "var(--color-blue-700)",
            "text": "var(--color-white)"
          },
          "secondary": {
            "DEFAULT": "var(--color-blue-200)",
            "lighter": "var(--color-blue-100)",
            "darker": "var(--color-blue-300)",
            "text": "var(--color-slate-800)"
          }
        },
        "price": {
          "DEFAULT": "var(--color-slate-900)",
          "special": "var(--color-slate-900)",
          "old": "var(--color-slate-400)"
        },
        "form": {
          "DEFAULT": "oklch(0 0 0 / 0.23)",
          "hover": "oklch(0 0 0 / 0.87)",
          "focus": "var(--color-brand-primary)"
        },
        "text": {
          "primary": "var(--color-slate-800)"
        },
        "input": {
          "border": {
            "default": "var(--color-slate-300)",
            "hover": "var(--color-brand-secondary-darker)",
            "error": "var(--color-system-error)",
            "success": "var(--color-system-success)",
            "disabled": "var(--color-slate-200)",
            "focus": "var(--color-brand-primary)",
            "warning": "var(--color-system-warning)"
          },
          "background": {
            "bg": "var(--color-white)",
            "bg-hover": "var(--color-white)",
            "bg-disabled": "var(--color-slate-50)",
            "bg-readonly": "var(--color-zinc-50)",
            "bg-active": "var(--color-white)"
          },
          "text": {
            "text": "var(--color-slate-800)",
            "placeholder": "var(--color-slate-500)",
            "text-disabled": "var(--color-slate-400)"
          }
        },
        "system": {
          "error": {
            "DEFAULT": "var(--color-red-600)",
            "bg": "var(--color-red-50)",
            "text": "var(--color-red-950)"
          },
          "success": {
            "DEFAULT": "var(--color-green-600)",
            "bg": "var(--color-green-50)",
            "text": "var(--color-green-950)"
          },
          "warning": {
            "DEFAULT": "var(--color-orange-400)",
            "bg": "var(--color-orange-50)",
            "text": "var(--color-orange-950)"
          },
          "info": {
            "DEFAULT": "var(--color-blue-600)",
            "bg": "var(--color-blue-50)",
            "text": "var(--color-blue-950)"
          }
        },
        "global-borders": {
          "subtle": "var(--color-slate-200)"
        },
        "background": {
          "muted": "var(--color-slate-50)"
        },
        "button": {
          "primary": {
            "background": {
              "default": "var(--color-brand-primary)",
              "focus": "var(--color-brand-primary-darker)",
              "hover": "var(--color-brand-primary-lighter)",
              "active": "var(--color-brand-primary-darker)",
              "disabled": "var(--color-slate-200)"
            },
            "text": {
              "primary": "var(--color-brand-primary-text)",
              "primary-hover": "var(--color-brand-primary-text)",
              "primary-disabled": "var(--color-slate-400)"
            },
            "border": {
              "default": "var(--color-blue-100)",
              "hover": "var(--color-brand-primary-darker)",
              "focus": "var(--color-brand-primary)",
              "active": "var(--color-brand-primary-darker)",
              "disabled": "var(--color-slate-200)"
            }
          },
          "secondary": {
            "background": {
              "default": "var(--color-brand-primary-text)",
              "hover": "var(--color-brand-primary)",
              "focus": "var(--color-brand-primary)",
              "active": "var(--color-brand-primary)",
              "disabled": "var(--color-slate-50)"
            },
            "text": {
              "primary": "var(--color-brand-primary)",
              "primary-hover": "var(--color-brand-primary-text)",
              "primary-disabled": "var(--color-slate-400)"
            },
            "border": {
              "default": "var(--color-brand-primary)",
              "hover": "var(--color-brand-primary)",
              "focus": "var(--color-brand-primary)",
              "active": "var(--color-brand-primary)",
              "disabled": "var(--color-slate-50)"
            }
          },
          "tertiary": {
            "background": {
              "default": "var(--color-white)",
              "hover": "var(--color-white)",
              "focus": "var(--color-white)",
              "active": "var(--color-white)",
              "disabled": "var(--color-white)"
            },
            "text": {
              "primary": "var(--color-brand-primary)",
              "primary-hover": "var(--color-brand-primary-darker)",
              "primary-disabled": "var(--color-slate-400)"
            },
            "border": {
              "default": "var(--color-blue-400)",
              "hover": "var(--color-brand-primary-lighter)",
              "focus": "var(--color-blue-400)",
              "active": "var(--color-brand-primary)",
              "disabled": "var(--color-slate-200)"
            }
          },
          "text": {
            "default": "var(--color-brand-primary)",
            "hover": "var(--color-brand-primary-darker)",
            "disabled": "var(--color-slate-400)",
            "focus": "var(--color-brand-primary-darker)",
            "active": "var(--color-blue-800)"
          }
        },
        "icon": {
          "primary": "var(--color-slate-900)"
        },
        "label": {
          "primary": "var(--color-slate-900)"
        },
        "on-primary": "var(--color-brand-primary-text)"
      },
      "form": {
        "radius": "var(--radius-lg)",
        "stroke": "var(--color-slate-400)",
        "active-color": "var(--color-brand-primary)"
      }
    }
  },
  "notice": [
    "This is a complementary config file for Tailwind v4 and is not a replacement for the Tailwind v3 config file.",
    "For usage, see the docs: https://docs.hyva.io/hyva-themes/working-with-tailwindcss/using-hyva-modules/"
  ]
}
